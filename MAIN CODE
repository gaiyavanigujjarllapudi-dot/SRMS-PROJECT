<!DOCTYPE html>
<html>
<head>
    <title>Browser History Simulator</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="container">
    <h2>Browser History Simulator</h2>

    <input type="text" id="urlInput" placeholder="Enter URL (example: google.com)">
    
    <button onclick="visitPage()">Visit Page</button>
    <button onclick="goBack()">Go Back</button>
    <button onclick="showCurrent()">Show Current Page</button>
    <button onclick="showHistory()">Show Full History</button>

    <div class="output" id="output">
        Output will appear here...
    </div>
</div>

<script src="script.js"></script>

</body>
</html>
